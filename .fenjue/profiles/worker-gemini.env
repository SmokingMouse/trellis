# mode: writable
# gemini 3.7 flash via cpa 网关(Antigravity 池)——快,scout/简单实现档
# key 单取(agent-gateway.env 有撇号地雷,禁整文件 source,见 seats.md 实弹)
export FJ_LAUNCH='env ANTHROPIC_BASE_URL=https://cpa.smokingmouse.cc ANTHROPIC_AUTH_TOKEN=$(grep "^CPA_API_KEY=" ~/.agent-gateway.env | cut -d= -f2-) ANTHROPIC_MODEL=gemini-3.7-flash-high ANTHROPIC_SMALL_FAST_MODEL=gemini-3.1-flash-lite claude --dangerously-skip-permissions'
